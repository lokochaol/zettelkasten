generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum QuickNoteSource {
  SCRATCH
  VOICE
}

enum QuickNoteStatus {
  ACTIVE
  ARCHIVED
}

enum LinkTargetType {
  PERMANENT_NOTE
  INDEX_ENTRY
}

enum DiscoveryKind {
  NEWS
  LITERATURE
}

enum DiscoveryStatus {
  CANDIDATE
  CONFIRMED
}

enum AiProvider {
  ANTHROPIC
  OPENAI
  GOOGLE
}

enum ProjectStatus {
  ACTIVE
  CLOSED
}

/// Why a QuickNote ended up ARCHIVED — distinct from "why", not "whether":
/// PROMOTED (the existing promotion workflow), STALE (the 1-week
/// auto-archive sweep for notes with no Project), or PROJECT_CLOSED (swept
/// along with its Project when that Project was closed). Null for any
/// QuickNote that's still ACTIVE.
enum QuickNoteArchiveReason {
  PROMOTED
  STALE
  PROJECT_CLOSED
}

/// A temporary, quickly-captured note ("走り書き"). Either typed on the spot
/// (SCRATCH) or, in a future phase, transcribed from a voice memo (VOICE — the
/// voice* columns are a schema hook only, not wired up in Phase 1). Active
/// notes live on the /dash-off timeline; once promoted into one or more
/// PermanentNotes they flip to ARCHIVED and disappear from that timeline.
model QuickNote {
  id       String          @id @default(uuid())
  ownerSub String          @map("owner_sub")
  source   QuickNoteSource @default(SCRATCH)
  status   QuickNoteStatus @default(ACTIVE)

  /// Plain-text/Markdown content — a single free-form document, VSCode-editor
  /// style, instead of a typed block list. ```lang fences embed code,
  /// ```mermaid fences embed diagrams, ![caption](url) embeds images; there's
  /// no other markdown syntax support beyond that (see MarkdownNoteEditor.tsx
  /// for the source/preview split and src/lib/embeddedContent.ts for parsing).
  content String @default("")

  literatureMemoId String?         @map("literature_memo_id")
  literatureMemo   LiteratureMemo? @relation(fields: [literatureMemoId], references: [id], onDelete: SetNull)

  /// Optional link to a Project — a QuickNote with a Project is exempt from
  /// the 1-week stale-auto-archive sweep (see archiveStaleQuickNotes in
  /// src/lib/quickNoteArchiving.ts) until that Project itself is closed, at
  /// which point it's archived along with it (archiveReason PROJECT_CLOSED).
  projectId String?  @map("project_id")
  project   Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  /// Set only when status is ARCHIVED — see QuickNoteArchiveReason.
  archiveReason QuickNoteArchiveReason? @map("archive_reason")

  // Phase 2 hooks — not populated by any Phase 1 code path.
  voiceAudioUrl        String? @map("voice_audio_url")
  voiceTranscript       String? @map("voice_transcript")
  voiceDurationSeconds  Int?    @map("voice_duration_seconds")

  encounteredAt DateTime @default(now()) @map("encountered_at")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  // Set each time the discovery batch actually attempts this note (success
  // or "found nothing" both count — only a failed provider call leaves it
  // untouched, see src/lib/discovery.ts). Drives the least-recently-run-first
  // rotation when there are more active notes than one run's cap allows.
  /// Opt-in: discovery only ever looks at notes the owner picked in the
  /// 探索 tab. It spends tokens on their own API key and most scraps never
  /// want it, so "every active note" was the wrong default.
  discoveryEnabled   Boolean  @default(false) @map("discovery_enabled")
  discoveryLastRunAt DateTime? @map("discovery_last_run_at")

  promotionSourceLinks PromotionSourceQuickNote[]
  discoveryCandidates  DiscoveryCandidate[]

  @@index([ownerSub, status, encounteredAt])
  @@index([literatureMemoId])
  @@index([projectId])
  @@map("quick_note")
}

/// A permanent note ("ツェッテルカステン" card). Lives in one strict,
/// owner-wide order (orderKey, fractional indexing — see src/lib/rank.ts) and
/// is only ever created through the promotion workflow (src/lib/promotion.ts)
/// — there is no direct `create`.
model PermanentNote {
  id       String @id @default(uuid())
  ownerSub String @map("owner_sub")
  title    String
  orderKey String @map("order_key")

  /// See QuickNote.content — same plain-text/Markdown model, no block table.
  content String @default("")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  /// Optional link to a Project — surfaced on the Project detail page's
  /// linked-notes list. PermanentNote has no active/archived concept, so
  /// unlike QuickNote there's nothing here to sweep when the Project closes.
  projectId String?  @map("project_id")
  project   Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  outboundLinks        PermanentNoteLink[]             @relation("LinkSource")
  inboundLinks         PermanentNoteLink[]             @relation("LinkTargetNote")
  indexEntries         IndexEntry[]
  promotionOutputLinks PromotionOutputPermanentNote[]
  literatureMemos      PermanentNoteLiteratureMemo[]

  @@unique([ownerSub, orderKey])
  @@index([ownerSub, orderKey])
  @@index([projectId])
  @@map("permanent_note")
}

/// A project ("プロジェクト") — the organizing unit for daily task notes. Every
/// owner gets one default project (isDefault, named after them) lazily
/// created on first need (see ensureDefaultProject in src/lib/projects.ts);
/// further projects are created explicitly.
model Project {
  id        String        @id @default(uuid())
  ownerSub  String        @map("owner_sub")
  name      String
  isDefault Boolean       @default(false) @map("is_default")
  status    ProjectStatus @default(ACTIVE)
  startedAt DateTime      @default(now()) @map("started_at")
  closedAt  DateTime?     @map("closed_at")
  createdAt DateTime      @default(now()) @map("created_at")
  updatedAt DateTime      @updatedAt @map("updated_at")

  /// All optional; enforced together in application code, not by the DB —
  /// if any goal tier is set, goalUltimate and goalDay must both be set too.
  goalUltimate String? @map("goal_ultimate")
  goalYear3    String? @map("goal_year3")
  goalYear2    String? @map("goal_year2")
  goalYear1    String? @map("goal_year1")
  goalMonth3   String? @map("goal_month3")
  goalMonth1   String? @map("goal_month1")
  goalDay      String? @map("goal_day")

  taskNotes      ProjectTaskNote[]
  quickNotes     QuickNote[]
  permanentNotes PermanentNote[]

  @@index([ownerSub, status])
  @@map("project")
}

/// One page of daily task-management notes for a Project — a composite key
/// of (project, date), edited in place via MarkdownNoteEditor the same way a
/// QuickNote/PermanentNote's content is.
model ProjectTaskNote {
  id        String   @id @default(uuid())
  projectId String   @map("project_id")
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  date      DateTime @db.Date
  content   String   @default("")
  /// When this day's unfinished entries were copied on to a later day
  /// (src/lib/projectTaskNotes.ts#carryForward). Set once, so a day is
  /// carried over at most once however many times the next day is opened.
  carriedForwardAt DateTime? @map("carried_forward_at")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([projectId, date])
  @@map("project_task_note")
}

/// A PermanentNote can carry several 文献メモ — e.g. when several selected
/// 走り書き, each citing a different source, are merged into one permanent
/// note, all of their distinct literature links carry over. (QuickNote stays
/// single-literature-memo — this many-to-many is PermanentNote-only.)
model PermanentNoteLiteratureMemo {
  id               String         @id @default(uuid())
  permanentNoteId  String         @map("permanent_note_id")
  permanentNote    PermanentNote  @relation(fields: [permanentNoteId], references: [id], onDelete: Cascade)
  literatureMemoId String         @map("literature_memo_id")
  literatureMemo   LiteratureMemo @relation(fields: [literatureMemoId], references: [id], onDelete: Cascade)
  createdAt        DateTime       @default(now()) @map("created_at")

  @@unique([permanentNoteId, literatureMemoId])
  @@index([literatureMemoId])
  @@map("permanent_note_literature_memo")
}

/// A link from a PermanentNote to either another PermanentNote or an
/// IndexEntry. `relationLabel` (e.g. "応用元") is the primary display text —
/// the target's title/keyword is a secondary annotation.
model PermanentNoteLink {
  id                 String         @id @default(uuid())
  sourceNoteId       String         @map("source_note_id")
  sourceNote         PermanentNote  @relation("LinkSource", fields: [sourceNoteId], references: [id], onDelete: Cascade)
  targetType         LinkTargetType @map("target_type")
  targetNoteId       String?        @map("target_note_id")
  targetNote         PermanentNote? @relation("LinkTargetNote", fields: [targetNoteId], references: [id], onDelete: Cascade)
  targetIndexEntryId String?        @map("target_index_entry_id")
  targetIndexEntry   IndexEntry?    @relation(fields: [targetIndexEntryId], references: [id], onDelete: Cascade)
  relationLabel      String         @map("relation_label")
  createdAt          DateTime       @default(now()) @map("created_at")

  @@index([sourceNoteId])
  @@index([targetNoteId])
  @@index([targetIndexEntryId])
  @@map("permanent_note_link")
}

/// A curated, owner-unique keyword pointing at one PermanentNote — the
/// entry point into the Zettelkasten's global order. Keeping the index small
/// and deliberate is a UX goal, not just a schema constraint.
model IndexEntry {
  id        String        @id @default(uuid())
  ownerSub  String        @map("owner_sub")
  keyword   String
  noteId    String        @map("note_id")
  note      PermanentNote @relation(fields: [noteId], references: [id], onDelete: Cascade)
  createdAt DateTime      @default(now()) @map("created_at")

  links PermanentNoteLink[]

  @@unique([ownerSub, keyword])
  @@index([ownerSub])
  @@map("index_entry")
}

/// One promotion transaction: a set of QuickNotes archived together to
/// produce a set of new PermanentNotes. Kept purely for history/audit —
/// Phase 1 only reads it via listBatchHistory.
model PromotionBatch {
  id        String   @id @default(uuid())
  ownerSub  String   @map("owner_sub")
  createdAt DateTime @default(now()) @map("created_at")

  sourceQuickNotes     PromotionSourceQuickNote[]
  outputPermanentNotes PromotionOutputPermanentNote[]

  @@index([ownerSub, createdAt])
  @@map("promotion_batch")
}

model PromotionSourceQuickNote {
  id          String         @id @default(uuid())
  batchId     String         @map("batch_id")
  batch       PromotionBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  quickNoteId String         @map("quick_note_id")
  quickNote   QuickNote      @relation(fields: [quickNoteId], references: [id], onDelete: Cascade)

  @@unique([batchId, quickNoteId])
  @@index([quickNoteId])
  @@map("promotion_source_quick_note")
}

model PromotionOutputPermanentNote {
  id              String         @id @default(uuid())
  batchId         String         @map("batch_id")
  batch           PromotionBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  permanentNoteId String         @map("permanent_note_id")
  permanentNote   PermanentNote  @relation(fields: [permanentNoteId], references: [id], onDelete: Cascade)

  @@unique([batchId, permanentNoteId])
  @@index([permanentNoteId])
  @@map("promotion_output_permanent_note")
}

/// A shared 文献メモ (literature memo) — citation info + an "in my own words"
/// summary for something read. 1:1 with a specific Zotero library item per
/// owner (deduped by ownerSub+zoteroKey — see @@unique below); manually
/// entered memos (zoteroKey null, e.g. Zotero not configured) skip dedup
/// entirely since Postgres treats each NULL as distinct. Referenced by many
/// QuickNotes and many PermanentNotes (many-to-one from each side).
model LiteratureMemo {
  id        String   @id @default(uuid())
  ownerSub  String   @map("owner_sub")
  zoteroKey String?  @map("zotero_key")
  citation  String
  url       String?
  summary   String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  quickNotes          QuickNote[]
  permanentNoteLinks  PermanentNoteLiteratureMemo[]
  discoveryCandidates DiscoveryCandidate[]
  discoveryTopicFindings DiscoveryTopicFinding[]

  @@unique([ownerSub, zoteroKey])
  @@index([ownerSub])
  @@map("literature_memo")
}

/// An AI-surfaced "might be related" suggestion (a news article or a piece
/// of literature) attached to one QuickNote — populated by the twice-daily
/// discovery batch (src/lib/discovery.ts, wired to run at 7:00/19:00 via
/// vercel.json's cron + src/app/api/cron/discovery). The app never judges
/// relevance itself: a candidate starts as CANDIDATE and only flips to
/// CONFIRMED when the owner acts on it — adding it as a literature memo, or
/// writing a new QuickNote from it. There is no separate "mark relevant"
/// action. `literatureMemoId` is set once the candidate has been turned into
/// (or matched to) a LiteratureMemo — see resolveLiteratureForCandidate's
/// URL-keyed find-or-create in src/lib/discovery.ts, which is how the same
/// article surfacing twice never creates two literature memos.
model DiscoveryCandidate {
  id          String          @id @default(uuid())
  ownerSub    String          @map("owner_sub")
  quickNoteId String          @map("quick_note_id")
  quickNote   QuickNote       @relation(fields: [quickNoteId], references: [id], onDelete: Cascade)
  kind        DiscoveryKind
  status      DiscoveryStatus @default(CANDIDATE)
  title       String
  summary     String
  sourceLabel String          @map("source_label")
  url         String?
  confidence  Int
  /// Null until /discovery has been opened after it was found — what the
  /// side bar's count of new finds counts. A refresh that finds the same
  /// thing again carries the mark over (see refreshQuickNote).
  seenAt      DateTime?       @map("seen_at")

  literatureMemoId String?         @map("literature_memo_id")
  literatureMemo   LiteratureMemo? @relation(fields: [literatureMemoId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now()) @map("created_at")

  @@index([quickNoteId])
  @@index([ownerSub, status])
  @@map("discovery_candidate")
}

/// One row per owner — the outcome of their most recent discovery batch run
/// (manual trigger or cron). `lastErrorCode`/`lastErrorStatus` are set only
/// when that run failed outright (bad/expired API key, rate limit, etc. —
/// see DiscoveryProviderError in src/lib/discovery.ts) so /dash-off can show
/// a banner; a clean run clears them. Never records "found nothing" as an
/// error — that's a normal outcome, not a failure.
model DiscoveryRunStatus {
  id              String    @id @default(uuid())
  ownerSub        String    @unique @map("owner_sub")
  lastRunAt       DateTime  @map("last_run_at")
  lastErrorCode   String?   @map("last_error_code")
  lastErrorStatus Int?      @map("last_error_status")
  lastErrorAt     DateTime? @map("last_error_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  @@map("discovery_run_status")
}

/// Per-owner customization of the discovery batch's cadence — how many
/// times a day (1 or 2) and at which Asia/Tokyo local hour(s). The cron
/// route (src/app/api/cron/discovery) fires hourly and checks each owner's
/// schedule to decide whether *this* hour is one of theirs; the manual
/// "今すぐ探す" trigger ignores this entirely and always runs immediately.
/// No row = the original fixed default (twice a day, 7:00/19:00).
model DiscoverySchedule {
  id          String   @id @default(uuid())
  ownerSub    String   @unique @map("owner_sub")
  /// 0 means discovery never runs on a schedule; the owner can still
  /// trigger it by hand. This is the default — an unattended job spending
  /// someone's API credits should be something they switched on.
  timesPerDay Int      @default(0) @map("times_per_day")
  hour1       Int      @default(7) @map("hour1")
  hour2       Int      @default(19) @map("hour2")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("discovery_schedule")
}

/// Per-user Zotero Web API credentials (this is a multi-tenant app — each
/// owner links their own Zotero library, never a single app-wide account).
/// apiKeyEncrypted holds AES-256-GCM ciphertext (see src/lib/crypto.ts),
/// never the plaintext key.
model ZoteroCredential {
  id              String   @id @default(uuid())
  ownerSub        String   @unique @map("owner_sub")
  apiKeyEncrypted String   @map("api_key_encrypted")
  libraryId       String   @map("library_id")
  libraryType     String   @default("user") @map("library_type")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@map("zotero_credential")
}

/// Per-user LLM API credential — whichever provider the owner brings their
/// own key for backs the discovery batch's search+summarize step (see
/// findCandidatesForNote in src/lib/discovery.ts). No app-wide default key:
/// without this row, discovery runs succeed but always find nothing, same
/// "gracefully unconfigured" shape as ZoteroCredential.
model AiCredential {
  id              String     @id @default(uuid())
  ownerSub        String     @unique @map("owner_sub")
  provider        AiProvider
  apiKeyEncrypted String     @map("api_key_encrypted")
  createdAt       DateTime   @default(now()) @map("created_at")
  updatedAt       DateTime   @updatedAt @map("updated_at")

  @@map("ai_credential")
}

/// Per-user Google Calendar link — same "each owner brings their own"
/// shape as ZoteroCredential/AiCredential, and the same reason: there is no
/// app-wide calendar, only the owner's. The refresh token is the durable
/// half (Google only hands it over once, on a consent with
/// access_type=offline), so it's stored AES-256-GCM encrypted like every
/// other third-party secret here; the access token is cached alongside it
/// purely to avoid a refresh round-trip on every read, and is worthless
/// after expiresAt.
///
/// Granted through an incremental-auth flow from Settings rather than at
/// sign-in (see src/app/api/google-calendar/connect), so signing in never
/// asks for calendar access unless the owner wants the integration.
model GoogleCalendarCredential {
  id                    String    @id @default(uuid())
  ownerSub              String    @unique @map("owner_sub")
  refreshTokenEncrypted String    @map("refresh_token_encrypted")
  accessTokenEncrypted  String?   @map("access_token_encrypted")
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at")
  /// Which calendar the timeline reads and writes. "primary" unless the
  /// owner ever picks another one.
  calendarId            String    @default("primary") @map("calendar_id")
  /// The space-separated scopes Google actually granted — checked before a
  /// write, since a consent can come back with less than was asked for.
  grantedScope          String    @map("granted_scope")
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  @@map("google_calendar_credential")
}

enum BiologicalSex {
  MALE
  FEMALE
}

/// How much day-to-day movement the owner does, used only when there's no
/// measured active energy to work from (see src/lib/nutritionTargets.ts).
enum ActivityLevel {
  SEDENTARY
  LIGHT
  MODERATE
  ACTIVE
}

/// The things about a body that don't change day to day. Entered by hand
/// once — HealthKit could supply some of it, but height and birth year
/// aren't worth an extra Shortcut round trip, and sex and goal aren't in
/// HealthKit in a form worth trusting.
model HealthProfile {
  ownerSub      String        @id @map("owner_sub")
  heightCm      Float         @map("height_cm")
  birthYear     Int           @map("birth_year")
  sex           BiologicalSex
  activityLevel ActivityLevel @default(LIGHT) @map("activity_level")
  /// Target rate of weight change per week, in kg. Negative loses weight.
  /// Bounded in the UI — an aggressive deficit is how a "healthy meals"
  /// app ends up recommending something unhealthy.
  weeklyKgDelta Float         @default(0) @map("weekly_kg_delta")
  /// The body composition being aimed at, as a body fat percentage. Once
  /// the scale is reporting, this replaces the weight goal: "athletic and
  /// functional" is a composition, not a number on a scale — the same
  /// 70 kg can be two very different bodies.
  targetBodyFatPercent Float? @map("target_body_fat_percent")
  /// Lean mass to build up to, when the goal is more muscle rather than
  /// only less fat. Optional: most goals are a body fat figure with the
  /// lean mass held. Read by the trainer, not by the nutrition targets.
  targetLeanMassKg Float?     @map("target_lean_mass_kg")
  /// Weight to use until the phone starts sending one — without it the
  /// targets can't be computed at all, and making the whole feature wait
  /// on a Shortcut being set up correctly is a bad first run.
  fallbackWeightKg Float?     @map("fallback_weight_kg")
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")

  @@map("health_profile")
}

/// One day's measurements, as sent by the iPhone Shortcut. Keyed by day
/// rather than by sample: the Shortcut posts a daily summary, and a resend
/// for the same day is a correction, not a second reading.
model HealthDailyMetric {
  id                String   @id @default(uuid())
  ownerSub          String   @map("owner_sub")
  /// "YYYY-MM-DD" in the owner's own time zone — the Shortcut runs on their
  /// phone, so the date it sends is already local.
  dateKey           String   @map("date_key")
  weightKg          Float?   @map("weight_kg")
  /// Apple's "active energy" — movement only, excluding resting burn, which
  /// is why the TDEE calculation adds it to BMR rather than replacing it.
  activeEnergyKcal  Float?   @map("active_energy_kcal")
  /// From a body composition scale, through Apple Health. The reason the
  /// targets can stop guessing: with a body fat percentage the lean mass
  /// is known, and lean mass is what protein and resting burn actually
  /// scale with — body weight is only ever a proxy for it.
  bodyFatPercent    Float?   @map("body_fat_percent")
  /// Sent when the scale reports it directly. Otherwise derived from
  /// weight and body fat, which is the same arithmetic — kept separate so
  /// a measured figure is never overwritten by a computed one.
  leanBodyMassKg    Float?   @map("lean_body_mass_kg")
  steps             Int?
  receivedAt        DateTime @default(now()) @map("received_at")

  @@unique([ownerSub, dateKey])
  @@index([ownerSub, dateKey])
  @@map("health_daily_metric")
}

/// Bearer token for the Shortcut's POST. Stored encrypted rather than
/// hashed because it has to be readable again: the owner sets the Shortcut
/// up on a phone, and a token they can only see once is a token they will
/// be re-issuing every time they edit that automation. Same AES-256-GCM
/// storage as every other secret here.
model HealthIngestToken {
  ownerSub       String   @id @map("owner_sub")
  tokenEncrypted String   @map("token_encrypted")
  /// First 8 characters, kept in the clear so an incoming token can be
  /// looked up without decrypting every row.
  tokenPrefix    String   @unique @map("token_prefix")
  lastUsedAt     DateTime? @map("last_used_at")
  /// What the last delivery carried — which fields, for which day, and
  /// which earlier days it filled in — so a Shortcut that runs but finds
  /// no weight in Health shows up as that, not as silence.
  lastReceipt    Json?    @map("last_receipt")
  createdAt      DateTime @default(now()) @map("created_at")

  @@map("health_ingest_token")
}

/// How a meal reaches the plate. The distinction is the whole point of
/// batch cooking: three meals a day is twenty-one plates a week, but it
/// need not be twenty-one cooking sessions.
enum MealKind {
  /// Cooked that day, from ingredients.
  COOK
  /// Portioned out of something cooked on an earlier day.
  BATCH
  /// Frozen or ready-made — opened and heated.
  READY

  @@map("meal_kind")
}

enum MealStatus {
  PLANNED
  EATEN
  SKIPPED
  REPLACED

  @@map("meal_status")
}

enum MealSlot {
  BREAKFAST
  LUNCH
  DINNER
}

/// The constraints a week's menu has to satisfy that aren't about the
/// body — money, time, and things the owner won't eat. Kept apart from
/// HealthProfile because these change with life rather than with weight.
model MealPreference {
  ownerSub          String   @id @map("owner_sub")
  /// Food budget for one week, in yen. The monthly figure the owner thinks
  /// in is divided down when they enter it — the planner buys by the week.
  weeklyBudgetYen   Int      @default(8000) @map("weekly_budget_yen")
  /// Minutes of cooking the owner will actually do on a weekday. The single
  /// most effective constraint on whether a plan survives contact with a
  /// Tuesday.
  weekdayCookMinutes Int     @default(20) @map("weekday_cook_minutes")
  /// Minutes the owner can spend in the kitchen on each weekday, Sunday
  /// first: [0, 20, 20, 0, 20, 20, 90]. 0 is a day they don't cook. Empty
  /// until set; then weekdays take weekdayCookMinutes and weekends 90.
  kitchenMinutes    Json     @default("[]") @map("kitchen_minutes")
  /// 0 = Sunday. The one shopping trip the whole week is planned around.
  shoppingWeekday   Int      @default(1) @map("shopping_weekday")
  /// 0 = Sunday. Which day the seven-day plan starts on. Separate from the
  /// shopping day because the two are genuinely different decisions: a
  /// Saturday shop feeding a week that runs Monday to Sunday is an
  /// ordinary way to live, and tying them together forced a plan to start
  /// on the day the shopping was done.
  weekStartWeekday  Int      @default(1) @map("week_start_weekday")
  /// Free text, passed to the planner as-is: "パクチーが苦手", "夜は炭水化物少なめ".
  dislikes          String   @default("")
  /// Kept separate from dislikes so it can be stated to the model as a hard
  /// constraint rather than a preference.
  allergies         String   @default("")
  /// When each meal happens, as minutes from midnight. The planner doesn't
  /// choose these — a meal is at the time the owner eats, not a time an
  /// AI picked — and they're what places meals on the day's timeline and
  /// in Google Calendar.
  breakfastMinutes  Int      @default(420) @map("breakfast_minutes")
  lunchMinutes      Int      @default(750) @map("lunch_minutes")
  dinnerMinutes     Int      @default(1140) @map("dinner_minutes")
  /// How many days a week the owner is willing to properly cook. The
  /// constraint that actually produces batch cooking: a per-day minute cap
  /// still puts someone in the kitchen every evening, which is the thing
  /// they wanted to avoid.
  cookSessionsPerWeek Int  @default(2) @map("cook_sessions_per_week")
  /// How many of the week's 21 meals may be frozen or ready-made. Zero is
  /// allowed and so is twenty-one; the planner is told the number rather
  /// than a moral position about convenience food.
  readyMadeMealsPerWeek Int @default(5) @map("ready_made_meals_per_week")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  @@map("meal_preference")
}

/// One week's menu. Keyed by the week's first day so regenerating replaces
/// rather than accumulates.
model MealPlan {
  id                String   @id @default(uuid())
  ownerSub          String   @map("owner_sub")
  weekStartDateKey  String   @map("week_start_date_key")
  /// The targets the plan was generated against, stored as they were at the
  /// time — weight and activity move, and a plan should be read against the
  /// brief it was actually written to.
  targetKcal        Int      @map("target_kcal")
  targetProteinG    Int      @map("target_protein_g")
  targetFiberG      Int      @map("target_fiber_g")
  /// The rest of the brief, stored for the same reason as the targets: so
  /// the plan can be re-checked against what it was actually written to,
  /// not against preferences that have since changed. Defaults cover the
  /// plans that predate these columns.
  targetSaltMaxG    Float    @default(7.5) @map("target_salt_max_g")
  cookSessionsPerWeek Int    @default(2) @map("cook_sessions_per_week")
  /// The kitchen minutes per weekday the plan was made against (see MealPreference).
  kitchenMinutes      Json     @default("[]") @map("kitchen_minutes")
  readyMadeMealsPerWeek Int  @default(5) @map("ready_made_meals_per_week")
  weekdayCookMinutes Int     @default(20) @map("weekday_cook_minutes")
  budgetYen         Int      @map("budget_yen")
  /// What the model was told, kept for debugging a plan that came out odd.
  promptSummary     String   @map("prompt_summary")
  createdAt         DateTime @default(now()) @map("created_at")

  meals         PlannedMeal[]
  shoppingItems ShoppingItem[]

  @@unique([ownerSub, weekStartDateKey])
  @@index([ownerSub, weekStartDateKey])
  @@map("meal_plan")
}

model PlannedMeal {
  id          String   @id @default(uuid())
  planId      String   @map("plan_id")
  plan        MealPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  dateKey     String   @map("date_key")
  slot        MealSlot
  title       String
  /// Ingredients and method, as plain text — same "a note is text" stance
  /// the rest of the app takes.
  recipe      String
  /// The recipe to cook from, written by the model when the owner asks
  /// for it (src/lib/mealRecipe.ts): ingredients for the portions actually
  /// made, numbered steps, and how to keep and reheat the rest. Null until
  /// asked — most meals are read as the short line above and never cooked
  /// from a screen.
  recipeDetail Json?   @map("recipe_detail")
  /// A recipe page the owner chose for this meal, opened while cooking.
  recipeUrl   String   @default("") @map("recipe_url")
  kcal        Int
  proteinG    Float    @map("protein_g")
  fatG        Float    @map("fat_g")
  carbG       Float    @map("carb_g")
  fiberG      Float    @map("fiber_g")
  saltG       Float    @map("salt_g")
  prepMinutes Int      @map("prep_minutes")
  /// Set once the meal has been written into Google Calendar, so a re-sync
  /// updates that event instead of creating a second one.
  googleEventId String? @map("google_event_id")
  /// What actually happened. A plan is a proposal; the dietitian's half of
  /// the job is the follow-up, and a day's real intake can only be known
  /// by asking. PLANNED means nothing has been said yet — which is not the
  /// same as "didn't eat it", and is never counted as either.
  /// Cooked, reheated from a batch, or opened out of the freezer.
  kind          MealKind   @default(COOK)
  status        MealStatus @default(PLANNED)
  /// What was eaten instead, when the answer was REPLACED. Free text, and
  /// deliberately not turned into numbers: the app cannot know the
  /// nutrition of a meal it never saw, and guessing would corrupt the one
  /// figure the owner is meant to trust.
  replacementNote String @default("") @map("replacement_note")

  @@unique([planId, dateKey, slot])
  @@index([planId, dateKey])
  @@map("planned_meal")
}

/// A line to buy. Belongs to exactly one of: a plan (the list the planner
/// priced the week with — what the budget check reads), or a purchase list
/// (what the owner actually takes to the shop — see PurchaseList).
model ShoppingItem {
  id           String   @id @default(uuid())
  planId       String?  @map("plan_id")
  plan         MealPlan? @relation(fields: [planId], references: [id], onDelete: Cascade)
  listId       String?  @map("list_id")
  list         PurchaseList? @relation(fields: [listId], references: [id], onDelete: Cascade)
  category     String
  name         String
  quantity     String
  estimatedYen Int      @map("estimated_yen")
  checked      Boolean  @default(false)
  /// Position within its category, as the planner ordered it.
  sortOrder    Int      @map("sort_order")
  /// The stock this item became when it was ticked off — see InventoryItem.
  inventoryItem InventoryItem?

  @@index([planId])
  @@index([listId])
  @@map("shopping_item")
}

/// What to buy on the next trip: the meals from one day for a few days,
/// less what's already at home. Made on request, after the meals are
/// settled, rather than with the plan — the plan is for a calendar week,
/// a trip covers whatever days come next, and the meals in between may have
/// been changed since. One per owner; making a new one replaces it.
model PurchaseList {
  id          String   @id @default(uuid())
  ownerSub    String   @unique @map("owner_sub")
  fromDateKey String   @map("from_date_key")
  toDateKey   String   @map("to_date_key")
  /// The meals the list was made from, as text. When the meals in those
  /// days no longer match, the list is out of date and says so.
  mealsDigest String   @map("meals_digest")
  note        String   @default("")
  /// Lines the model asked for that the inventory already holds, set aside
  /// rather than dropped: [{ category, name, quantity, estimatedYen, stock }]
  /// where `stock` is the inventory line it matched. Shown under the list so
  /// a short supply ("4 eggs, need 10") can be put back with one tap.
  excluded    Json     @default("[]")
  createdAt   DateTime @default(now()) @map("created_at")

  items ShoppingItem[]

  @@map("purchase_list")
}

enum ExpenseSource {
  /// Typed in at the time of spending — the day-to-day half.
  MANUAL
  /// Came from an imported statement CSV — the long-term half.
  CSV
}

/// One expense. Category is a free string rather than an enum: what
/// someone tracks changes with their life, and a migration is the wrong
/// thing to need when it does. CategoryBudget names the ones that matter.
model Expense {
  id        String        @id @default(uuid())
  ownerSub  String        @map("owner_sub")
  /// "YYYY-MM-DD" in the owner's own time zone, like every other day key
  /// here — spending belongs to the day it felt like, not to UTC.
  dateKey   String        @map("date_key")
  /// Yen, whole numbers. No currency column: this is a single-currency app
  /// for a single person, and a nullable currency nobody sets is worse
  /// than none.
  amountYen Int           @map("amount_yen")
  category  String
  memo      String        @default("")
  source    ExpenseSource @default(MANUAL)
  /// Set on imported rows: a stable fingerprint of the statement line, so
  /// re-importing an overlapping CSV doesn't duplicate what's already in.
  externalKey String?     @map("external_key")
  createdAt DateTime      @default(now()) @map("created_at")

  @@unique([ownerSub, externalKey])
  @@index([ownerSub, dateKey])
  @@map("expense")
}

/// A monthly ceiling for one category. Absent means the category is
/// tracked but not budgeted — which is a normal state, not zero.
model CategoryBudget {
  id         String   @id @default(uuid())
  ownerSub   String   @map("owner_sub")
  category   String
  monthlyYen Int      @map("monthly_yen")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@unique([ownerSub, category])
  @@map("category_budget")
}

/// How one card or bank's CSV is shaped. Remembered per owner so the
/// second import of the same statement is a drop, not a re-mapping —
/// every issuer names its columns differently and none of them will
/// change to suit us.
model CsvImportProfile {
  id           String   @id @default(uuid())
  ownerSub     String   @map("owner_sub")
  /// The owner's name for it: "楽天カード", "住信SBI" …
  name         String
  dateColumn   String   @map("date_column")
  amountColumn String   @map("amount_column")
  memoColumn   String   @map("memo_column")
  /// Some issuers write outgoings as positive, others as negative. Stored
  /// rather than guessed per file, because a sign flip silently turns a
  /// month of spending into a month of income.
  amountIsNegativeForSpending Boolean @default(false) @map("amount_is_negative_for_spending")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@unique([ownerSub, name])
  @@map("csv_import_profile")
}

/// "Anything whose description contains this goes in that category."
/// Learned as the owner categorises imported rows, so the next statement
/// arrives mostly sorted.
model CategoryRule {
  id       String @id @default(uuid())
  ownerSub String @map("owner_sub")
  /// Matched case-insensitively as a substring. Not a regex: these are
  /// written by hand and a bad regex fails in ways that are hard to see.
  keyword  String
  category String

  @@unique([ownerSub, keyword])
  @@index([ownerSub])
  @@map("category_rule")
}

/// A block of time the owner put on the day themselves.
///
/// Not everything that takes an hour is a calendar event or a meal. A task
/// from the day's note needs somewhere to actually happen, and deciding
/// when is the owner's job, not the planner's. Stored here rather than
/// written to Google Calendar: the calendar may not be linked at all, and
/// this has to work either way.
model TimeBlock {
  id              String   @id @default(uuid())
  ownerSub        String   @map("owner_sub")
  dateKey         String   @map("date_key")
  /// Minutes from local midnight — a clock time, not an instant, so it
  /// means the same thing whatever the owner's zone does that day.
  startMinutes    Int      @map("start_minutes")
  durationMinutes Int      @map("duration_minutes")
  title           String
  /// "DAY_PLAN" for one written from the day's plan (GoalDayPlan) when the
  /// calendar isn't linked; replaced whole when the plan is written again.
  source          String   @default("")
  createdAt       DateTime @default(now()) @map("created_at")

  @@index([ownerSub, dateKey])
  @@map("time_block")
}

/// What comes in, and the floor under what must go out.
///
/// Budgeting without income is arithmetic with one side missing — the
/// current category budgets are numbers typed from memory, and nothing
/// checks them against what there is to spend.
model MoneyProfile {
  ownerSub           String   @id @map("owner_sub")
  monthlyIncomeYen   Int      @default(0) @map("monthly_income_yen")
  /// The least this household can run on in a month, food and daily
  /// necessities included. A plan that goes under it isn't thrift, it's a
  /// plan that will be broken in week two — so it's flagged rather than
  /// quietly proposed.
  minimumLivingYen   Int      @default(40000) @map("minimum_living_yen")
  /// Kept back for the unexpected before anything is called savings.
  bufferYen          Int      @default(20000) @map("buffer_yen")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  @@map("money_profile")
}

enum CommitmentKind {
  /// Instalments already signed for — the past arriving monthly.
  INSTALMENT
  /// Subscriptions and dues.
  SUBSCRIPTION
  /// Rent, utilities, insurance.
  FIXED

  @@map("commitment_kind")
}

/// Money already promised to someone else. Planning a year without these
/// is planning someone else's year.
model Commitment {
  id         String         @id @default(uuid())
  ownerSub   String         @map("owner_sub")
  name       String
  kind       CommitmentKind
  monthlyYen Int            @map("monthly_yen")
  /// Inclusive "YYYY-MM" bounds. An open end (null) is an ongoing cost;
  /// an instalment has a last month, and that month is when the plan
  /// gets easier — which is worth being able to see coming.
  fromMonth  String         @map("from_month")
  toMonth    String?        @map("to_month")
  createdAt  DateTime       @default(now()) @map("created_at")

  @@index([ownerSub])
  @@map("commitment")
}

/// Something being saved for, by when.
model SavingsGoal {
  id          String   @id @default(uuid())
  ownerSub    String   @map("owner_sub")
  name        String
  targetYen   Int      @map("target_yen")
  targetMonth String   @map("target_month")
  /// Put aside so far. Typed in rather than inferred: what's in the
  /// account is something only the owner can see.
  savedYen    Int      @default(0) @map("saved_yen")
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([ownerSub])
  @@map("savings_goal")
}

/// The plan for one month: what each category may have.
///
/// Separate from CategoryBudget, which is a standing figure. This is the
/// month's own allocation, derived at the start of the month from income
/// minus what is already promised, and adjustable afterwards.
model MonthBudget {
  id        String   @id @default(uuid())
  ownerSub  String   @map("owner_sub")
  month     String
  category  String
  amountYen Int      @map("amount_yen")
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([ownerSub, month, category])
  @@index([ownerSub, month])
  @@map("month_budget")
}

/// One week's advice from the AI acting as the household's accountant.
///
/// Stored, not regenerated on sight: it costs the owner an API call, it
/// is about a week that has now happened, and advice that changes every
/// time you open the page is advice nobody follows.
model SpendingAdvice {
  id               String   @id @default(uuid())
  ownerSub         String   @map("owner_sub")
  weekStartDateKey String   @map("week_start_date_key")
  /// What the week actually looked like when the advice was written, so
  /// it can be read against its own evidence later.
  summary          String
  /// The concrete cuts, as JSON: [{ category, action, monthlySavingYen }].
  actionsJson      String   @map("actions_json")
  createdAt        DateTime @default(now()) @map("created_at")

  @@unique([ownerSub, weekStartDateKey])
  @@index([ownerSub])
  @@map("spending_advice")
}

/// Where something is kept. Decides which list it shows in, and tells the
/// planner how long it can wait to be used.
enum StorageLocation {
  FRIDGE
  FREEZER
  PANTRY
}

/// One thing in the fridge, freezer or cupboard.
///
/// Free text on purpose — "鶏むね肉 1枚" and "卵 残り4個" are how stock is
/// actually counted at home, and a unit system would get in the way of
/// writing it down at the shop. The meal chat reads and edits these as text.
model InventoryItem {
  id        String          @id @default(uuid())
  ownerSub  String          @map("owner_sub")
  name      String
  quantity  String          @default("")
  location  StorageLocation @default(FRIDGE)
  /// Set when the item came from ticking a shopping-list line, so unticking
  /// it takes the same stock back out. Cleared (not deleted) if the plan the
  /// line belonged to is regenerated: what was bought is still in the fridge.
  shoppingItemId String?       @unique @map("shopping_item_id")
  shoppingItem   ShoppingItem? @relation(fields: [shoppingItemId], references: [id], onDelete: SetNull)
  createdAt DateTime        @default(now()) @map("created_at")
  updatedAt DateTime        @updatedAt @map("updated_at")

  @@index([ownerSub])
  @@map("inventory_item")
}

enum MealChatRole {
  USER
  ASSISTANT
}

/// One message in the conversation the week's meals are made and changed
/// in — what to eat, what was actually bought, what ran out. Kept per owner
/// and week rather than per plan: the conversation starts before there is a
/// plan (it's how the plan gets made). Stored, so it survives a reload (and
/// a login that runs out) mid-shop.
model MealChatMessage {
  id               String       @id @default(uuid())
  ownerSub         String       @map("owner_sub")
  weekStartDateKey String       @map("week_start_date_key")
  role        MealChatRole
  content     String
  /// An assistant message's proposed changes — meals and stock —
  /// as JSON (see src/lib/mealChat.ts). Nothing changes until it's applied.
  proposal    Json?
  appliedAt   DateTime?    @map("applied_at")
  /// Turned down: the proposal stays readable but can no longer be applied.
  dismissedAt DateTime?    @map("dismissed_at")
  createdAt   DateTime     @default(now()) @map("created_at")

  @@index([ownerSub, weekStartDateKey, createdAt])
  @@map("meal_chat_message")
}

/// How training fits into the owner's week — the constraints the trainer
/// plans inside, like MealPreference is for meals.
model TrainingPreference {
  ownerSub          String   @id @map("owner_sub")
  /// Days a week available to train. The plan never schedules more.
  daysPerWeek       Int      @default(3) @map("days_per_week")
  minutesPerSession Int      @default(45) @map("minutes_per_session")
  /// Where and with what — "ジム", "自宅（ダンベル 2〜10kg、懸垂バー）".
  /// Free text: equipment lists don't fit an enum.
  equipment         String   @default("")
  /// Injuries, pain, things not to load. Treated as hard constraints.
  limitations       String   @default("")
  /// What "functional" means for this owner beyond the composition —
  /// "懸垂10回", "5kmを30分で", "腰痛を出さない".
  focus             String   @default("")
  experience        TrainingExperience @default(BEGINNER)
  updatedAt         DateTime @updatedAt @map("updated_at")

  @@map("training_preference")
}

enum TrainingExperience {
  BEGINNER
  INTERMEDIATE
  ADVANCED

  @@map("training_experience")
}

/// A week of training as the trainer wrote it, with the reading of the
/// previous weeks that it was written from.
model TrainingPlan {
  id               String   @id @default(uuid())
  ownerSub         String   @map("owner_sub")
  weekStartDateKey String   @map("week_start_date_key")
  /// The trainer's analysis: how the composition moved, what was actually
  /// done, and what that changes this week. Shown above the sessions so
  /// the plan arrives with its reasons.
  analysis         String   @default("")
  /// The week's aim in a sentence.
  focus            String   @default("")
  createdAt        DateTime @default(now()) @map("created_at")

  sessions TrainingSession[]

  @@unique([ownerSub, weekStartDateKey])
  @@map("training_plan")
}

enum TrainingKind {
  STRENGTH
  CARDIO
  MOBILITY

  @@map("training_kind")
}

enum TrainingStatus {
  PLANNED
  DONE
  SKIPPED

  @@map("training_status")
}

model TrainingSession {
  id        String         @id @default(uuid())
  planId    String         @map("plan_id")
  plan      TrainingPlan   @relation(fields: [planId], references: [id], onDelete: Cascade)
  dateKey   String         @map("date_key")
  title     String
  kind      TrainingKind
  minutes   Int
  /// [{ name, sets, reps, load, note }] — a list, not separate rows,
  /// because it's read and written whole and never queried by exercise.
  exercises Json
  /// The trainer's cue for the session (form, effort, what to watch).
  notes     String         @default("")
  status    TrainingStatus @default(PLANNED)
  /// How hard it felt, 1–10. With the log, what the next analysis reads.
  rpe       Int?
  /// What was actually done, in the owner's words.
  log       String         @default("")
  sortOrder Int            @map("sort_order")

  @@index([planId, dateKey])
  @@map("training_session")
}

enum TrainingChatRole {
  USER
  ASSISTANT

  @@map("training_chat_role")
}

/// The conversation with the trainer about a week — "my knee hurts",
/// "only 30 minutes on Wednesday", "more upper body". Kept per owner and
/// week like the meal chat, so it starts before there's a plan and
/// survives remaking one.
model TrainingChatMessage {
  id               String           @id @default(uuid())
  ownerSub         String           @map("owner_sub")
  weekStartDateKey String           @map("week_start_date_key")
  role             TrainingChatRole
  content          String
  /// An assistant message's proposed session changes as JSON (see
  /// src/lib/trainingChat.ts). Nothing changes until it's applied.
  proposal         Json?
  appliedAt        DateTime?        @map("applied_at")
  dismissedAt      DateTime?        @map("dismissed_at")
  createdAt        DateTime         @default(now()) @map("created_at")

  @@index([ownerSub, weekStartDateKey, createdAt])
  @@map("training_chat_message")
}

/// What the goals stand on — the owner's 指針, いまある幸せ, これだけあれば,
/// 障害プランニング and anything kept from earlier years. Markdown each, one
/// row per owner: these are read as a whole and rewritten rarely.
model GoalCompass {
  ownerSub   String   @id @map("owner_sub")
  /// 前提となる生き方の指針.
  principles String   @default("")
  /// いまある幸せ.
  happiness  String   @default("")
  /// これだけあれば他に何もいらない.
  essentials String   @default("")
  /// 障害プランニング — "if this gets in the way, then do that".
  obstacles  String   @default("")
  /// Earlier years' goals and reflections, kept to look back on.
  archive    String   @default("")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@map("goal_compass")
}

enum GoalStatus {
  ACTIVE
  ARCHIVED

  @@map("goal_status")
}

/// A 🚩 — an outcome worked towards, with the steps towards it at a few
/// horizons (GoalMilestone). Reviewed now and then; each review keeps the
/// version it replaced (GoalRevision).
model Goal {
  id                String     @id @default(uuid())
  ownerSub          String     @map("owner_sub")
  title             String
  /// What reaching it means, and why — markdown.
  statement         String     @default("")
  /// The day it was last looked at and rewritten ("2026.6.18").
  reviewedOnDateKey String?    @map("reviewed_on_date_key")
  status            GoalStatus @default(ACTIVE)
  sortOrder         Int        @default(0) @map("sort_order")
  /// One of the palette names in src/lib/goalColors.ts; "" picks one by
  /// position. The goal's colour everywhere: Gantt rows, the week's slots,
  /// the records.
  color             String     @default("")
  /// 当面の進め方 — how it's being worked on for now.
  approach          String     @default("")
  /// The week's time budget for it (desk + commute). 0 = not budgeted.
  weeklyHours       Float      @default(0) @map("weekly_hours")
  /// Of weeklyHours, how much is done while commuting.
  commuteHours      Float      @default(0) @map("commute_hours")
  /// What the budgeted time includes (課題、制作、読書…).
  budgetNote        String     @default("") @map("budget_note")
  /// 継続して残す最小限の記録.
  keepRecord        String     @default("") @map("keep_record")
  /// 4〜12週で確認する改善.
  improveCheck      String     @default("") @map("improve_check")
  createdAt         DateTime   @default(now()) @map("created_at")
  updatedAt         DateTime   @updatedAt @map("updated_at")

  milestones   GoalMilestone[]
  revisions    GoalRevision[]
  outcomes     GoalCycleOutcome[]
  slots        GoalWeekSlot[]
  events       GoalEvent[]
  checks       GoalCheck[]
  tasks        GoalTask[]
  deliverables GoalDeliverable[]
  experiments  GoalExperiment[]
  subPlans     GoalSubPlan[]

  @@index([ownerSub, status, sortOrder])
  @@map("goal")
}

/// One horizon of a goal — "~2週間後", "1年後", "毎日の活動" — with what is
/// to be true by then. The label is free text because horizons are the
/// owner's own; the date is there when the horizon has one, and is what
/// the calendar uses to say a step is coming up.
model GoalMilestone {
  id         String    @id @default(uuid())
  goalId     String    @map("goal_id")
  goal       Goal      @relation(fields: [goalId], references: [id], onDelete: Cascade)
  label      String    @default("")
  /// With a due date, a phase on the roadmap's Gantt chart from this day
  /// to that one; without, a horizon that's only a point.
  startDateKey String?   @map("start_date_key")
  dueDateKey String?   @map("due_date_key")
  /// 次へ進む条件 — what has to be true before the next phase.
  condition  String    @default("")
  /// The steps themselves and their notes — markdown.
  body       String    @default("")
  doneAt     DateTime? @map("done_at")
  sortOrder  Int       @default(0) @map("sort_order")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  @@index([goalId, sortOrder])
  @@map("goal_milestone")
}

/// The goal as it stood before a review: { title, statement,
/// reviewedOnDateKey, milestones: [{ label, dueDateKey, body, done }] }.
/// Read whole, never queried into, so JSON.
model GoalRevision {
  id        String   @id @default(uuid())
  goalId    String   @map("goal_id")
  goal      Goal     @relation(fields: [goalId], references: [id], onDelete: Cascade)
  /// The day of the review that replaced it.
  dateKey   String   @map("date_key")
  snapshot  Json
  createdAt DateTime @default(now()) @map("created_at")

  @@index([goalId, createdAt])
  @@map("goal_revision")
}

/// 日々のタスクと意識する目標 — for a stretch of days ("7/1まで"), which
/// goals a weekday, a day off and the spare moments go to. Each slot is
/// [{ goalId, note }] (goalId null for a line that isn't any one goal's),
/// a list read and written whole.
model GoalFocusPeriod {
  id          String   @id @default(uuid())
  ownerSub    String   @map("owner_sub")
  label       String   @default("")
  /// Inclusive bounds; either may be open.
  fromDateKey String?  @map("from_date_key")
  toDateKey   String?  @map("to_date_key")
  weekday     Json     @default("[]")
  holiday     Json     @default("[]")
  spare       Json     @default("[]")
  sortOrder   Int      @default(0) @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([ownerSub, sortOrder])
  @@map("goal_focus_period")
}

/// Something to keep looking into, written straight on /discovery — not a
/// 走り書き, so the one-week sweep never takes it, and it stays until the
/// owner deletes it.
model DiscoveryTopic {
  id        String    @id @default(uuid())
  ownerSub  String    @map("owner_sub")
  content   String
  /// Off keeps the topic and what it found, but the runs skip it.
  enabled   Boolean   @default(true)
  lastRunAt DateTime? @map("last_run_at")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  findings DiscoveryTopicFinding[]

  @@index([ownerSub, createdAt])
  @@map("discovery_topic")
}

/// What a run found for a topic. Unlike a 走り書き's candidates, which a
/// refresh replaces, these accumulate: a later run only adds what wasn't
/// already found (same URL, or same title when there's none), and nothing
/// goes until the owner dismisses it. `seenAt` null is what makes it new.
model DiscoveryTopicFinding {
  id          String         @id @default(uuid())
  topicId     String         @map("topic_id")
  topic       DiscoveryTopic @relation(fields: [topicId], references: [id], onDelete: Cascade)
  ownerSub    String         @map("owner_sub")
  kind        DiscoveryKind
  title       String
  summary     String
  sourceLabel String         @map("source_label")
  url         String?
  confidence  Int
  seenAt      DateTime?      @map("seen_at")

  literatureMemoId String?         @map("literature_memo_id")
  literatureMemo   LiteratureMemo? @relation(fields: [literatureMemoId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now()) @map("created_at")

  @@index([topicId, createdAt])
  @@index([ownerSub, seenAt])
  @@map("discovery_topic_finding")
}

/// The plan as a whole, one per owner: the vision the goals serve, the
/// assumptions it was made on, where the week's 168 hours go, and the rules
/// for what to change when something is observed (src/lib/goalPlan.ts).
model GoalPlan {
  ownerSub      String   @id @map("owner_sub")
  title         String   @default("")
  /// 目指す姿 — markdown.
  vision        String   @default("")
  /// 基準・性格 — the plan's version, basis and how provisional it is.
  baseline      String   @default("")
  /// The week's 168 hours: [{ label, hours, note }].
  lifeBudget    Json     @default("[]") @map("life_budget")
  /// 何が起きたら、何を変えるか — markdown, read by the advisor too.
  decisionRules String   @default("") @map("decision_rules")
  /// The day's fixed frame: { bed, wake, days: [{ weekday, work, start, end,
  /// office, commuteMinutes }] } — what a day's plan is built around.
  routine       Json     @default("{}")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@map("goal_plan")
}

/// A run of weeks with its own targets — "最初の12週間". `phases` splits it
/// into stretches ([{ label, fromDateKey, toDateKey }], e.g. 4 weeks each);
/// each outcome has a line per phase.
model GoalCycle {
  id          String   @id @default(uuid())
  ownerSub    String   @map("owner_sub")
  label       String   @default("")
  fromDateKey String   @map("from_date_key")
  toDateKey   String   @map("to_date_key")
  note        String   @default("")
  phases      Json     @default("[]")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  outcomes GoalCycleOutcome[]

  @@index([ownerSub, fromDateKey])
  @@map("goal_cycle")
}

/// What one goal is to reach in a cycle, the evidence that says it did,
/// and what each phase of the cycle does towards it.
model GoalCycleOutcome {
  id         String    @id @default(uuid())
  cycleId    String    @map("cycle_id")
  cycle      GoalCycle @relation(fields: [cycleId], references: [id], onDelete: Cascade)
  goalId     String?   @map("goal_id")
  goal       Goal?     @relation(fields: [goalId], references: [id], onDelete: SetNull)
  /// For a row that isn't one goal's ("管理").
  area       String    @default("")
  target     String    @default("")
  evidence   String    @default("")
  hoursNote  String    @default("") @map("hours_note")
  /// One line per cycle phase, in order.
  phaseTexts Json      @default("[]") @map("phase_texts")
  sortOrder  Int       @default(0) @map("sort_order")

  @@index([cycleId, sortOrder])
  @@map("goal_cycle_outcome")
}

/// One block of the standard week — "火 06:00〜07:00 IT：問い・設計案".
model GoalWeekSlot {
  id        String  @id @default(uuid())
  ownerSub  String  @map("owner_sub")
  /// 0 = Sunday … 6 = Saturday.
  weekday   Int
  startTime String  @map("start_time")
  endTime   String  @map("end_time")
  goalId    String? @map("goal_id")
  goal      Goal?   @relation(fields: [goalId], references: [id], onDelete: SetNull)
  label     String  @default("")
  /// Done on the commute rather than at a desk.
  commute   Boolean @default(false)

  @@index([ownerSub, weekday])
  @@map("goal_week_slot")
}

/// A dated thing the plan has to meet: a deadline, an application window
/// (dateKey〜endDateKey), a class day, a review.
model GoalEvent {
  id         String   @id @default(uuid())
  ownerSub   String   @map("owner_sub")
  goalId     String?  @map("goal_id")
  goal       Goal?    @relation(fields: [goalId], references: [id], onDelete: SetNull)
  /// DEADLINE / APPLICATION / EVENT / REVIEW.
  kind       String   @default("EVENT")
  title      String
  dateKey    String   @map("date_key")
  endDateKey String?  @map("end_date_key")
  /// A candidate until it's booked or confirmed.
  confirmed  Boolean  @default(false)
  done       Boolean  @default(false)
  note       String   @default("")
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([ownerSub, dateKey])
  @@map("goal_event")
}

/// Something the plan rests on that isn't known yet — "卒業設計の最短1年の
/// 起算点" — with how to find out and what it changes.
model GoalCheck {
  id         String    @id @default(uuid())
  ownerSub   String    @map("owner_sub")
  goalId     String?   @map("goal_id")
  goal       Goal?     @relation(fields: [goalId], references: [id], onDelete: SetNull)
  question   String
  method     String    @default("")
  impact     String    @default("")
  dueDateKey String?   @map("due_date_key")
  answer     String    @default("")
  doneAt     DateTime? @map("done_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  @@index([ownerSub, createdAt])
  @@map("goal_check")
}

/// A one-off thing to do for the plan — "12月SCの受講要件を確認する".
model GoalTask {
  id         String    @id @default(uuid())
  ownerSub   String    @map("owner_sub")
  goalId     String?   @map("goal_id")
  goal       Goal?     @relation(fields: [goalId], references: [id], onDelete: SetNull)
  text       String
  dueDateKey String?   @map("due_date_key")
  doneAt     DateTime? @map("done_at")
  sortOrder  Int       @default(0) @map("sort_order")
  createdAt  DateTime  @default(now()) @map("created_at")

  @@index([ownerSub, sortOrder])
  @@map("goal_task")
}

/// The day's 1–2 minute record: hours actually spent per goal
/// ({ goalId: hours }), how much of it on the commute, what moved, what
/// stuck, the next step.
model GoalDailyLog {
  id           String   @id @default(uuid())
  ownerSub     String   @map("owner_sub")
  dateKey      String   @map("date_key")
  /// A schooling week, a trip — not compared with normal weeks.
  special      Boolean  @default(false)
  hours        Json     @default("{}")
  commuteHours Float    @default(0) @map("commute_hours")
  progress     String   @default("")
  blocker      String   @default("")
  next         String   @default("")
  life         String   @default("")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@unique([ownerSub, dateKey])
  @@map("goal_daily_log")
}

/// A review: WEEKLY (the Sunday 20 minutes), FOUR_WEEK or TWELVE_WEEK.
/// `dateKey` is the first day of the week it reviews (weekly) or the day it
/// was held. Its fields are read and written whole (see goalPlan.ts).
model GoalReview {
  id        String   @id @default(uuid())
  ownerSub  String   @map("owner_sub")
  kind      String
  dateKey   String   @map("date_key")
  special   Boolean  @default(false)
  data      Json     @default("{}")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([ownerSub, kind, dateKey])
  @@map("goal_review")
}

/// One of the week's priority deliverables (at most three a week): what,
/// the condition for "done this week", its state, the evidence and when to
/// look again. Carried across weeks while it's still moving.
model GoalDeliverable {
  id               String   @id @default(uuid())
  ownerSub         String   @map("owner_sub")
  goalId           String?  @map("goal_id")
  goal             Goal?    @relation(fields: [goalId], references: [id], onDelete: SetNull)
  weekStartDateKey String   @map("week_start_date_key")
  title            String
  condition        String   @default("")
  /// NOT_STARTED / IN_PROGRESS / STEP_DONE / SUBMITTED / WAITING /
  /// NEEDS_FIX / CONFIRMED.
  status           String   @default("NOT_STARTED")
  evidence         String   @default("")
  checkDateKey     String?  @map("check_date_key")
  statusChangedAt  DateTime @default(now()) @map("status_changed_at")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  @@index([ownerSub, weekStartDateKey])
  @@map("goal_deliverable")
}

/// One improvement tried at a time: observation → hypothesis → the one
/// change → the evidence that will tell → the day to decide.
model GoalExperiment {
  id            String   @id @default(uuid())
  ownerSub      String   @map("owner_sub")
  goalId        String?  @map("goal_id")
  goal          Goal?    @relation(fields: [goalId], references: [id], onDelete: SetNull)
  observation   String   @default("")
  hypothesis    String   @default("")
  change        String   @default("")
  evidence      String   @default("")
  reviewDateKey String?  @map("review_date_key")
  keepIf        String   @default("") @map("keep_if")
  otherwise     String   @default("")
  /// RUNNING / KEPT / ADJUSTED / REVERTED.
  status        String   @default("RUNNING")
  outcome       String   @default("")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@index([ownerSub, createdAt])
  @@map("goal_experiment")
}

/// 計画の変更履歴: what changed, from what, on what evidence. Written by hand,
/// and by every applied advisor proposal and import, so the plan's history
/// is never rewritten to look better.
model GoalChangeLog {
  id           String   @id @default(uuid())
  ownerSub     String   @map("owner_sub")
  dateKey      String   @map("date_key")
  before       String   @default("")
  after        String   @default("")
  reason       String   @default("")
  checkDateKey String?  @map("check_date_key")
  /// MANUAL / ADVISOR / IMPORT.
  source       String   @default("MANUAL")
  createdAt    DateTime @default(now()) @map("created_at")

  @@index([ownerSub, createdAt])
  @@map("goal_change_log")
}

/// The conversation with the goal advisor. An assistant message may carry
/// a proposal (src/lib/goalAdvisor.ts); nothing changes until it's applied.
model GoalAdvisorMessage {
  id          String    @id @default(uuid())
  ownerSub    String    @map("owner_sub")
  role        String
  content     String
  proposal    Json?
  appliedAt   DateTime? @map("applied_at")
  dismissedAt DateTime? @map("dismissed_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  @@index([ownerSub, createdAt])
  @@map("goal_advisor_message")
}

/// The plan written out as one document (the kind of Markdown the owner's
/// roadmap is), one row per version: written in the advisor's planning
/// conversation, imported from a file, or edited by hand. The newest is the
/// plan's 計画書; the rows before it are its earlier versions.
model GoalPlanDocument {
  id        String   @id @default(uuid())
  ownerSub  String   @map("owner_sub")
  markdown  String
  /// ADVISOR | IMPORT | MANUAL
  source    String   @default("MANUAL")
  /// How it was applied: FULL (the plan rewritten from it) or MERGE.
  applied   String   @default("")
  /// Set for an area's detailed plan (GoalSubPlan); null for the whole plan.
  subPlanId String?  @map("sub_plan_id")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([ownerSub, createdAt])
  @@index([subPlanId, createdAt])
  @@map("goal_plan_document")
}

/// One area's detailed plan — e.g. a degree's course plan under 大学・建築:
/// the ledger of items (courses, assignments) with their size and state,
/// the dated steps of each (work periods, drafts, checks, submission
/// targets with a fallback, sessions), a week-by-week execution table and
/// a day-by-day table for the first days (src/lib/goalSubPlan.ts).
model GoalSubPlan {
  id          String     @id @default(uuid())
  ownerSub    String     @map("owner_sub")
  goalId      String?    @map("goal_id")
  goal        Goal?      @relation(fields: [goalId], references: [id], onDelete: SetNull)
  title       String
  summary     String     @default("")
  /// What an item's size counts ("単位"), and the total aimed at (124).
  unitLabel   String     @default("") @map("unit_label")
  targetTotal Float      @default(0) @map("target_total")
  /// Already counted outside the ledger (credits transferred in, say).
  baseDone    Float      @default(0) @map("base_done")
  /// The execution table's column headings, and its rows:
  /// [{ label, fromDateKey, toDateKey, cells: string[] }].
  weekColumns Json       @default("[]") @map("week_columns")
  weeks       Json       @default("[]")
  /// The day-by-day table: [{ dateKey, time, work, output }].
  days        Json       @default("[]")
  sortOrder   Int        @default(0) @map("sort_order")
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")
  items       GoalItem[]
  steps       GoalItemStep[]

  @@index([ownerSub, sortOrder])
  @@map("goal_sub_plan")
}

/// A line of a detailed plan's ledger: a course, an assignment, a module.
model GoalItem {
  id          String         @id @default(uuid())
  subPlanId   String         @map("sub_plan_id")
  subPlan     GoalSubPlan    @relation(fields: [subPlanId], references: [id], onDelete: Cascade)
  /// The ledger's section ("登録中", "専門必修", "選択必修" …).
  group       String         @default("")
  code        String         @default("")
  title       String
  /// S/T, 必修 … — how it's taken.
  kind        String         @default("")
  /// Credits or the like, in the plan's unitLabel.
  size        Float          @default(0)
  /// PLANNED / REGISTERED / IN_PROGRESS / SUBMITTED / PASSED / DONE / DROPPED.
  status      String         @default("PLANNED")
  /// What's on record now ("報告①B、SC①優").
  record      String         @default("")
  /// When it's aimed at ("2027前期"), and as dates when known.
  periodLabel String         @default("") @map("period_label")
  fromDateKey String?        @map("from_date_key")
  toDateKey   String?        @map("to_date_key")
  /// What to leave behind for a good result.
  note        String         @default("")
  sortOrder   Int            @default(0) @map("sort_order")
  steps       GoalItemStep[]

  @@index([subPlanId, sortOrder])
  @@map("goal_item")
}

/// A dated step of a detailed plan: a work period (with a start), or a
/// point — draft, check, submission target (with a fallback date), session,
/// decision. On an item, or on the plan itself.
model GoalItemStep {
  id            String      @id @default(uuid())
  subPlanId     String      @map("sub_plan_id")
  subPlan       GoalSubPlan @relation(fields: [subPlanId], references: [id], onDelete: Cascade)
  itemId        String?     @map("item_id")
  item          GoalItem?   @relation(fields: [itemId], references: [id], onDelete: Cascade)
  label         String
  /// WORK / DRAFT / CHECK / DUE / SESSION / DECISION / OTHER.
  kind          String      @default("OTHER")
  startDateKey  String?     @map("start_date_key")
  dateKey       String      @map("date_key")
  backupDateKey String?     @map("backup_date_key")
  doneAt        DateTime?   @map("done_at")
  note          String      @default("")
  sortOrder     Int         @default(0) @map("sort_order")

  @@index([subPlanId, dateKey])
  @@map("goal_item_step")
}

/// One day's plan: the day laid out in blocks — sleep, work and commute,
/// the goals' blocks, meals, fixed appointments — drafted from the routine
/// and the plan, talked over with the advisor, then written into the
/// calendar (src/lib/dayPlan.ts).
model GoalDayPlan {
  id        String    @id @default(uuid())
  ownerSub  String    @map("owner_sub")
  dateKey   String    @map("date_key")
  /// [{ id, start, end, title, kind, goalId, note, fixed, push }].
  blocks    Json      @default("[]")
  note      String    @default("")
  /// Events written to the calendar: [{ key, eventId }] — kept so writing
  /// again updates them instead of adding a second set.
  pushed    Json      @default("[]")
  /// "google" or "app": where it was last written.
  pushedTo  String    @default("") @map("pushed_to")
  pushedAt  DateTime? @map("pushed_at")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  @@unique([ownerSub, dateKey])
  @@map("goal_day_plan")
}

/// The conversation about one day's plan. An assistant message may carry a
/// proposed day (blocks); nothing changes until it's applied.
model GoalDayPlanMessage {
  id          String    @id @default(uuid())
  ownerSub    String    @map("owner_sub")
  dateKey     String    @map("date_key")
  role        String
  content     String
  proposal    Json?
  appliedAt   DateTime? @map("applied_at")
  dismissedAt DateTime? @map("dismissed_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  @@index([ownerSub, dateKey, createdAt])
  @@map("goal_day_plan_message")
}
