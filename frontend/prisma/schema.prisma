generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum QuickNoteSource {
  SCRATCH
  VOICE
}

enum QuickNoteStatus {
  ACTIVE
  ARCHIVED
}

enum LinkTargetType {
  PERMANENT_NOTE
  INDEX_ENTRY
}

enum DiscoveryKind {
  NEWS
  LITERATURE
}

enum DiscoveryStatus {
  CANDIDATE
  CONFIRMED
}

enum AiProvider {
  ANTHROPIC
  OPENAI
  GOOGLE
}

enum ProjectStatus {
  ACTIVE
  CLOSED
}

/// Why a QuickNote ended up ARCHIVED — distinct from "why", not "whether":
/// PROMOTED (the existing promotion workflow), STALE (the 1-week
/// auto-archive sweep for notes with no Project), or PROJECT_CLOSED (swept
/// along with its Project when that Project was closed). Null for any
/// QuickNote that's still ACTIVE.
enum QuickNoteArchiveReason {
  PROMOTED
  STALE
  PROJECT_CLOSED
}

/// A temporary, quickly-captured note ("走り書き"). Either typed on the spot
/// (SCRATCH) or, in a future phase, transcribed from a voice memo (VOICE — the
/// voice* columns are a schema hook only, not wired up in Phase 1). Active
/// notes live on the /scratch timeline; once promoted into one or more
/// PermanentNotes they flip to ARCHIVED and disappear from that timeline.
model QuickNote {
  id       String          @id @default(uuid())
  ownerSub String          @map("owner_sub")
  source   QuickNoteSource @default(SCRATCH)
  status   QuickNoteStatus @default(ACTIVE)

  /// Plain-text/Markdown content — a single free-form document, VSCode-editor
  /// style, instead of a typed block list. ```lang fences embed code,
  /// ```mermaid fences embed diagrams, ![caption](url) embeds images; there's
  /// no other markdown syntax support beyond that (see MarkdownNoteEditor.tsx
  /// for the source/preview split and src/lib/embeddedContent.ts for parsing).
  content String @default("")

  literatureMemoId String?         @map("literature_memo_id")
  literatureMemo   LiteratureMemo? @relation(fields: [literatureMemoId], references: [id], onDelete: SetNull)

  /// Optional link to a Project — a QuickNote with a Project is exempt from
  /// the 1-week stale-auto-archive sweep (see archiveStaleQuickNotes in
  /// src/lib/quickNoteArchiving.ts) until that Project itself is closed, at
  /// which point it's archived along with it (archiveReason PROJECT_CLOSED).
  projectId String?  @map("project_id")
  project   Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  /// Set only when status is ARCHIVED — see QuickNoteArchiveReason.
  archiveReason QuickNoteArchiveReason? @map("archive_reason")

  // Phase 2 hooks — not populated by any Phase 1 code path.
  voiceAudioUrl        String? @map("voice_audio_url")
  voiceTranscript       String? @map("voice_transcript")
  voiceDurationSeconds  Int?    @map("voice_duration_seconds")

  encounteredAt DateTime @default(now()) @map("encountered_at")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  // Set each time the discovery batch actually attempts this note (success
  // or "found nothing" both count — only a failed provider call leaves it
  // untouched, see src/lib/discovery.ts). Drives the least-recently-run-first
  // rotation when there are more active notes than one run's cap allows.
  discoveryLastRunAt DateTime? @map("discovery_last_run_at")

  promotionSourceLinks PromotionSourceQuickNote[]
  discoveryCandidates  DiscoveryCandidate[]

  @@index([ownerSub, status, encounteredAt])
  @@index([literatureMemoId])
  @@index([projectId])
  @@map("quick_note")
}

/// A permanent note ("ツェッテルカステン" card). Lives in one strict,
/// owner-wide order (orderKey, fractional indexing — see src/lib/rank.ts) and
/// is only ever created through the promotion workflow (src/lib/promotion.ts)
/// — there is no direct `create`.
model PermanentNote {
  id       String @id @default(uuid())
  ownerSub String @map("owner_sub")
  title    String
  orderKey String @map("order_key")

  /// See QuickNote.content — same plain-text/Markdown model, no block table.
  content String @default("")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  /// Optional link to a Project — surfaced on the Project detail page's
  /// linked-notes list. PermanentNote has no active/archived concept, so
  /// unlike QuickNote there's nothing here to sweep when the Project closes.
  projectId String?  @map("project_id")
  project   Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  outboundLinks        PermanentNoteLink[]             @relation("LinkSource")
  inboundLinks         PermanentNoteLink[]             @relation("LinkTargetNote")
  indexEntries         IndexEntry[]
  promotionOutputLinks PromotionOutputPermanentNote[]
  literatureMemos      PermanentNoteLiteratureMemo[]

  @@unique([ownerSub, orderKey])
  @@index([ownerSub, orderKey])
  @@index([projectId])
  @@map("permanent_note")
}

/// A project ("プロジェクト") — the organizing unit for daily task notes. Every
/// owner gets one default project (isDefault, named after them) lazily
/// created on first need (see ensureDefaultProject in src/lib/projects.ts);
/// further projects are created explicitly.
model Project {
  id        String        @id @default(uuid())
  ownerSub  String        @map("owner_sub")
  name      String
  isDefault Boolean       @default(false) @map("is_default")
  status    ProjectStatus @default(ACTIVE)
  startedAt DateTime      @default(now()) @map("started_at")
  closedAt  DateTime?     @map("closed_at")
  createdAt DateTime      @default(now()) @map("created_at")
  updatedAt DateTime      @updatedAt @map("updated_at")

  /// All optional; enforced together in application code, not by the DB —
  /// if any goal tier is set, goalUltimate and goalDay must both be set too.
  goalUltimate String? @map("goal_ultimate")
  goalYear3    String? @map("goal_year3")
  goalYear2    String? @map("goal_year2")
  goalYear1    String? @map("goal_year1")
  goalMonth3   String? @map("goal_month3")
  goalMonth1   String? @map("goal_month1")
  goalDay      String? @map("goal_day")

  taskNotes      ProjectTaskNote[]
  quickNotes     QuickNote[]
  permanentNotes PermanentNote[]

  @@index([ownerSub, status])
  @@map("project")
}

/// One page of daily task-management notes for a Project — a composite key
/// of (project, date), edited in place via MarkdownNoteEditor the same way a
/// QuickNote/PermanentNote's content is.
model ProjectTaskNote {
  id        String   @id @default(uuid())
  projectId String   @map("project_id")
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  date      DateTime @db.Date
  content   String   @default("")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([projectId, date])
  @@map("project_task_note")
}

/// A PermanentNote can carry several 文献メモ — e.g. when several selected
/// 走り書き, each citing a different source, are merged into one permanent
/// note, all of their distinct literature links carry over. (QuickNote stays
/// single-literature-memo — this many-to-many is PermanentNote-only.)
model PermanentNoteLiteratureMemo {
  id               String         @id @default(uuid())
  permanentNoteId  String         @map("permanent_note_id")
  permanentNote    PermanentNote  @relation(fields: [permanentNoteId], references: [id], onDelete: Cascade)
  literatureMemoId String         @map("literature_memo_id")
  literatureMemo   LiteratureMemo @relation(fields: [literatureMemoId], references: [id], onDelete: Cascade)
  createdAt        DateTime       @default(now()) @map("created_at")

  @@unique([permanentNoteId, literatureMemoId])
  @@index([literatureMemoId])
  @@map("permanent_note_literature_memo")
}

/// A link from a PermanentNote to either another PermanentNote or an
/// IndexEntry. `relationLabel` (e.g. "応用元") is the primary display text —
/// the target's title/keyword is a secondary annotation.
model PermanentNoteLink {
  id                 String         @id @default(uuid())
  sourceNoteId       String         @map("source_note_id")
  sourceNote         PermanentNote  @relation("LinkSource", fields: [sourceNoteId], references: [id], onDelete: Cascade)
  targetType         LinkTargetType @map("target_type")
  targetNoteId       String?        @map("target_note_id")
  targetNote         PermanentNote? @relation("LinkTargetNote", fields: [targetNoteId], references: [id], onDelete: Cascade)
  targetIndexEntryId String?        @map("target_index_entry_id")
  targetIndexEntry   IndexEntry?    @relation(fields: [targetIndexEntryId], references: [id], onDelete: Cascade)
  relationLabel      String         @map("relation_label")
  createdAt          DateTime       @default(now()) @map("created_at")

  @@index([sourceNoteId])
  @@index([targetNoteId])
  @@index([targetIndexEntryId])
  @@map("permanent_note_link")
}

/// A curated, owner-unique keyword pointing at one PermanentNote — the
/// entry point into the Zettelkasten's global order. Keeping the index small
/// and deliberate is a UX goal, not just a schema constraint.
model IndexEntry {
  id        String        @id @default(uuid())
  ownerSub  String        @map("owner_sub")
  keyword   String
  noteId    String        @map("note_id")
  note      PermanentNote @relation(fields: [noteId], references: [id], onDelete: Cascade)
  createdAt DateTime      @default(now()) @map("created_at")

  links PermanentNoteLink[]

  @@unique([ownerSub, keyword])
  @@index([ownerSub])
  @@map("index_entry")
}

/// One promotion transaction: a set of QuickNotes archived together to
/// produce a set of new PermanentNotes. Kept purely for history/audit —
/// Phase 1 only reads it via listBatchHistory.
model PromotionBatch {
  id        String   @id @default(uuid())
  ownerSub  String   @map("owner_sub")
  createdAt DateTime @default(now()) @map("created_at")

  sourceQuickNotes     PromotionSourceQuickNote[]
  outputPermanentNotes PromotionOutputPermanentNote[]

  @@index([ownerSub, createdAt])
  @@map("promotion_batch")
}

model PromotionSourceQuickNote {
  id          String         @id @default(uuid())
  batchId     String         @map("batch_id")
  batch       PromotionBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  quickNoteId String         @map("quick_note_id")
  quickNote   QuickNote      @relation(fields: [quickNoteId], references: [id], onDelete: Cascade)

  @@unique([batchId, quickNoteId])
  @@index([quickNoteId])
  @@map("promotion_source_quick_note")
}

model PromotionOutputPermanentNote {
  id              String         @id @default(uuid())
  batchId         String         @map("batch_id")
  batch           PromotionBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  permanentNoteId String         @map("permanent_note_id")
  permanentNote   PermanentNote  @relation(fields: [permanentNoteId], references: [id], onDelete: Cascade)

  @@unique([batchId, permanentNoteId])
  @@index([permanentNoteId])
  @@map("promotion_output_permanent_note")
}

/// A shared 文献メモ (literature memo) — citation info + an "in my own words"
/// summary for something read. 1:1 with a specific Zotero library item per
/// owner (deduped by ownerSub+zoteroKey — see @@unique below); manually
/// entered memos (zoteroKey null, e.g. Zotero not configured) skip dedup
/// entirely since Postgres treats each NULL as distinct. Referenced by many
/// QuickNotes and many PermanentNotes (many-to-one from each side).
model LiteratureMemo {
  id        String   @id @default(uuid())
  ownerSub  String   @map("owner_sub")
  zoteroKey String?  @map("zotero_key")
  citation  String
  url       String?
  summary   String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  quickNotes          QuickNote[]
  permanentNoteLinks  PermanentNoteLiteratureMemo[]
  discoveryCandidates DiscoveryCandidate[]

  @@unique([ownerSub, zoteroKey])
  @@index([ownerSub])
  @@map("literature_memo")
}

/// An AI-surfaced "might be related" suggestion (a news article or a piece
/// of literature) attached to one QuickNote — populated by the twice-daily
/// discovery batch (src/lib/discovery.ts, wired to run at 7:00/19:00 via
/// vercel.json's cron + src/app/api/cron/discovery). The app never judges
/// relevance itself: a candidate starts as CANDIDATE and only flips to
/// CONFIRMED when the owner acts on it — adding it as a literature memo, or
/// writing a new QuickNote from it. There is no separate "mark relevant"
/// action. `literatureMemoId` is set once the candidate has been turned into
/// (or matched to) a LiteratureMemo — see resolveLiteratureForCandidate's
/// URL-keyed find-or-create in src/lib/discovery.ts, which is how the same
/// article surfacing twice never creates two literature memos.
model DiscoveryCandidate {
  id          String          @id @default(uuid())
  ownerSub    String          @map("owner_sub")
  quickNoteId String          @map("quick_note_id")
  quickNote   QuickNote       @relation(fields: [quickNoteId], references: [id], onDelete: Cascade)
  kind        DiscoveryKind
  status      DiscoveryStatus @default(CANDIDATE)
  title       String
  summary     String
  sourceLabel String          @map("source_label")
  url         String?
  confidence  Int

  literatureMemoId String?         @map("literature_memo_id")
  literatureMemo   LiteratureMemo? @relation(fields: [literatureMemoId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now()) @map("created_at")

  @@index([quickNoteId])
  @@index([ownerSub, status])
  @@map("discovery_candidate")
}

/// One row per owner — the outcome of their most recent discovery batch run
/// (manual trigger or cron). `lastErrorCode`/`lastErrorStatus` are set only
/// when that run failed outright (bad/expired API key, rate limit, etc. —
/// see DiscoveryProviderError in src/lib/discovery.ts) so /scratch can show
/// a banner; a clean run clears them. Never records "found nothing" as an
/// error — that's a normal outcome, not a failure.
model DiscoveryRunStatus {
  id              String    @id @default(uuid())
  ownerSub        String    @unique @map("owner_sub")
  lastRunAt       DateTime  @map("last_run_at")
  lastErrorCode   String?   @map("last_error_code")
  lastErrorStatus Int?      @map("last_error_status")
  lastErrorAt     DateTime? @map("last_error_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  @@map("discovery_run_status")
}

/// Per-owner customization of the discovery batch's cadence — how many
/// times a day (1 or 2) and at which Asia/Tokyo local hour(s). The cron
/// route (src/app/api/cron/discovery) fires hourly and checks each owner's
/// schedule to decide whether *this* hour is one of theirs; the manual
/// "今すぐ探す" trigger ignores this entirely and always runs immediately.
/// No row = the original fixed default (twice a day, 7:00/19:00).
model DiscoverySchedule {
  id          String   @id @default(uuid())
  ownerSub    String   @unique @map("owner_sub")
  timesPerDay Int      @default(2) @map("times_per_day")
  hour1       Int      @default(7) @map("hour1")
  hour2       Int      @default(19) @map("hour2")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("discovery_schedule")
}

/// Per-user Zotero Web API credentials (this is a multi-tenant app — each
/// owner links their own Zotero library, never a single app-wide account).
/// apiKeyEncrypted holds AES-256-GCM ciphertext (see src/lib/crypto.ts),
/// never the plaintext key.
model ZoteroCredential {
  id              String   @id @default(uuid())
  ownerSub        String   @unique @map("owner_sub")
  apiKeyEncrypted String   @map("api_key_encrypted")
  libraryId       String   @map("library_id")
  libraryType     String   @default("user") @map("library_type")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@map("zotero_credential")
}

/// Per-user LLM API credential — whichever provider the owner brings their
/// own key for backs the discovery batch's search+summarize step (see
/// findCandidatesForNote in src/lib/discovery.ts). No app-wide default key:
/// without this row, discovery runs succeed but always find nothing, same
/// "gracefully unconfigured" shape as ZoteroCredential.
model AiCredential {
  id              String     @id @default(uuid())
  ownerSub        String     @unique @map("owner_sub")
  provider        AiProvider
  apiKeyEncrypted String     @map("api_key_encrypted")
  createdAt       DateTime   @default(now()) @map("created_at")
  updatedAt       DateTime   @updatedAt @map("updated_at")

  @@map("ai_credential")
}

/// Per-user Google Calendar link — same "each owner brings their own"
/// shape as ZoteroCredential/AiCredential, and the same reason: there is no
/// app-wide calendar, only the owner's. The refresh token is the durable
/// half (Google only hands it over once, on a consent with
/// access_type=offline), so it's stored AES-256-GCM encrypted like every
/// other third-party secret here; the access token is cached alongside it
/// purely to avoid a refresh round-trip on every read, and is worthless
/// after expiresAt.
///
/// Granted through an incremental-auth flow from Settings rather than at
/// sign-in (see src/app/api/google-calendar/connect), so signing in never
/// asks for calendar access unless the owner wants the integration.
model GoogleCalendarCredential {
  id                    String    @id @default(uuid())
  ownerSub              String    @unique @map("owner_sub")
  refreshTokenEncrypted String    @map("refresh_token_encrypted")
  accessTokenEncrypted  String?   @map("access_token_encrypted")
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at")
  /// Which calendar the timeline reads and writes. "primary" unless the
  /// owner ever picks another one.
  calendarId            String    @default("primary") @map("calendar_id")
  /// The space-separated scopes Google actually granted — checked before a
  /// write, since a consent can come back with less than was asked for.
  grantedScope          String    @map("granted_scope")
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  @@map("google_calendar_credential")
}

enum BiologicalSex {
  MALE
  FEMALE
}

/// How much day-to-day movement the owner does, used only when there's no
/// measured active energy to work from (see src/lib/nutritionTargets.ts).
enum ActivityLevel {
  SEDENTARY
  LIGHT
  MODERATE
  ACTIVE
}

/// The things about a body that don't change day to day. Entered by hand
/// once — HealthKit could supply some of it, but height and birth year
/// aren't worth an extra Shortcut round trip, and sex and goal aren't in
/// HealthKit in a form worth trusting.
model HealthProfile {
  ownerSub      String        @id @map("owner_sub")
  heightCm      Float         @map("height_cm")
  birthYear     Int           @map("birth_year")
  sex           BiologicalSex
  activityLevel ActivityLevel @default(LIGHT) @map("activity_level")
  /// Target rate of weight change per week, in kg. Negative loses weight.
  /// Bounded in the UI — an aggressive deficit is how a "healthy meals"
  /// app ends up recommending something unhealthy.
  weeklyKgDelta Float         @default(0) @map("weekly_kg_delta")
  /// Weight to use until the phone starts sending one — without it the
  /// targets can't be computed at all, and making the whole feature wait
  /// on a Shortcut being set up correctly is a bad first run.
  fallbackWeightKg Float?     @map("fallback_weight_kg")
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")

  @@map("health_profile")
}

/// One day's measurements, as sent by the iPhone Shortcut. Keyed by day
/// rather than by sample: the Shortcut posts a daily summary, and a resend
/// for the same day is a correction, not a second reading.
model HealthDailyMetric {
  id                String   @id @default(uuid())
  ownerSub          String   @map("owner_sub")
  /// "YYYY-MM-DD" in the owner's own time zone — the Shortcut runs on their
  /// phone, so the date it sends is already local.
  dateKey           String   @map("date_key")
  weightKg          Float?   @map("weight_kg")
  /// Apple's "active energy" — movement only, excluding resting burn, which
  /// is why the TDEE calculation adds it to BMR rather than replacing it.
  activeEnergyKcal  Float?   @map("active_energy_kcal")
  steps             Int?
  receivedAt        DateTime @default(now()) @map("received_at")

  @@unique([ownerSub, dateKey])
  @@index([ownerSub, dateKey])
  @@map("health_daily_metric")
}

/// Bearer token for the Shortcut's POST. Stored encrypted rather than
/// hashed because it has to be readable again: the owner sets the Shortcut
/// up on a phone, and a token they can only see once is a token they will
/// be re-issuing every time they edit that automation. Same AES-256-GCM
/// storage as every other secret here.
model HealthIngestToken {
  ownerSub       String   @id @map("owner_sub")
  tokenEncrypted String   @map("token_encrypted")
  /// First 8 characters, kept in the clear so an incoming token can be
  /// looked up without decrypting every row.
  tokenPrefix    String   @unique @map("token_prefix")
  lastUsedAt     DateTime? @map("last_used_at")
  createdAt      DateTime @default(now()) @map("created_at")

  @@map("health_ingest_token")
}

enum MealSlot {
  BREAKFAST
  LUNCH
  DINNER
}

/// The constraints a week's menu has to satisfy that aren't about the
/// body — money, time, and things the owner won't eat. Kept apart from
/// HealthProfile because these change with life rather than with weight.
model MealPreference {
  ownerSub          String   @id @map("owner_sub")
  /// Food budget for one week, in yen. The monthly figure the owner thinks
  /// in is divided down when they enter it — the planner buys by the week.
  weeklyBudgetYen   Int      @default(8000) @map("weekly_budget_yen")
  /// Minutes of cooking the owner will actually do on a weekday. The single
  /// most effective constraint on whether a plan survives contact with a
  /// Tuesday.
  weekdayCookMinutes Int     @default(20) @map("weekday_cook_minutes")
  /// 0 = Sunday. The one shopping trip the whole week is planned around.
  shoppingWeekday   Int      @default(1) @map("shopping_weekday")
  /// Free text, passed to the planner as-is: "パクチーが苦手", "夜は炭水化物少なめ".
  dislikes          String   @default("")
  /// Kept separate from dislikes so it can be stated to the model as a hard
  /// constraint rather than a preference.
  allergies         String   @default("")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  @@map("meal_preference")
}

/// One week's menu. Keyed by the week's first day so regenerating replaces
/// rather than accumulates.
model MealPlan {
  id                String   @id @default(uuid())
  ownerSub          String   @map("owner_sub")
  weekStartDateKey  String   @map("week_start_date_key")
  /// The targets the plan was generated against, stored as they were at the
  /// time — weight and activity move, and a plan should be read against the
  /// brief it was actually written to.
  targetKcal        Int      @map("target_kcal")
  targetProteinG    Int      @map("target_protein_g")
  targetFiberG      Int      @map("target_fiber_g")
  budgetYen         Int      @map("budget_yen")
  /// What the model was told, kept for debugging a plan that came out odd.
  promptSummary     String   @map("prompt_summary")
  createdAt         DateTime @default(now()) @map("created_at")

  meals         PlannedMeal[]
  shoppingItems ShoppingItem[]

  @@unique([ownerSub, weekStartDateKey])
  @@index([ownerSub, weekStartDateKey])
  @@map("meal_plan")
}

model PlannedMeal {
  id          String   @id @default(uuid())
  planId      String   @map("plan_id")
  plan        MealPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  dateKey     String   @map("date_key")
  slot        MealSlot
  title       String
  /// Ingredients and method, as plain text — same "a note is text" stance
  /// the rest of the app takes.
  recipe      String
  kcal        Int
  proteinG    Float    @map("protein_g")
  fatG        Float    @map("fat_g")
  carbG       Float    @map("carb_g")
  fiberG      Float    @map("fiber_g")
  saltG       Float    @map("salt_g")
  prepMinutes Int      @map("prep_minutes")
  /// Set once the meal has been written into Google Calendar, so a re-sync
  /// updates that event instead of creating a second one.
  googleEventId String? @map("google_event_id")

  @@unique([planId, dateKey, slot])
  @@index([planId, dateKey])
  @@map("planned_meal")
}

model ShoppingItem {
  id           String   @id @default(uuid())
  planId       String   @map("plan_id")
  plan         MealPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  category     String
  name         String
  quantity     String
  estimatedYen Int      @map("estimated_yen")
  checked      Boolean  @default(false)
  /// Position within its category, as the planner ordered it.
  sortOrder    Int      @map("sort_order")

  @@index([planId])
  @@map("shopping_item")
}
