DATABASE_URL=postgresql://word_encounter:word_encounter@localhost:5432/word_encounter?schema=public
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# AES-256-GCM key used to encrypt per-user third-party credentials at rest
# (Zotero, and the AI provider key each owner sets in Settings — see
# src/lib/crypto.ts). Any passphrase works; it's hashed to a 32-byte key.
CREDENTIAL_ENCRYPTION_KEY=

# Discovery Rails (src/lib/discovery.ts) — AI-surfaced literature/news
# candidates for active Dash Off notes. There is no app-wide AI API key —
# each owner brings their own (Claude/ChatGPT/Gemini) via Settings, encrypted
# with CREDENTIAL_ENCRYPTION_KEY above. Without one configured, discovery
# runs (manual trigger or cron) succeed but always find nothing.
# CRON_SECRET: shared secret Vercel Cron sends as `Authorization: Bearer
# <value>` when calling /api/cron/discovery (see vercel.json). Without it,
# that endpoint always returns 401.
CRON_SECRET=

# Google Search Console のURLプレフィックスプロパティを「HTMLタグ」で確認する
# ためのトークン。Search Consoleが表示する
# <meta name="google-site-verification" content="..."> の content の値だけを
# 入れる(タグ全体ではない)。*.vercel.app はDNSレコードを追加できないため、
# ドメインプロパティ(TXTレコード)は使えずこの方法になる。
# 未設定でも本番のトークンが src/app/layout.tsx に直接書かれているので、
# これを設定するのは別のデプロイ先を自分のプロパティとして確認したいとき。
GOOGLE_SITE_VERIFICATION=

# Googleカレンダー連携は、ログインと同じOAuthクライアント
# (AUTH_GOOGLE_ID/SECRET) を使い、設定画面から追加でカレンダー権限を求める
# 増分認証で行う。専用の環境変数は不要だが、Google Cloud Console 側で
# 以下2点の設定が必要:
#   1. 承認済みリダイレクトURIに {オリジン}/api/google-calendar/callback を追加
#      (例: http://localhost:3000/api/google-calendar/callback)
#   2. OAuth同意画面のスコープに
#      https://www.googleapis.com/auth/calendar.events を追加
# calendar.events は Google の「機密性の高いスコープ」に該当するため、
# 本番公開時はアプリの審査が必要になる場合がある。また同意画面が
# 「テスト」状態のままだと、リフレッシュトークンが7日で失効し連携が切れる。
